{
  "extends": ["config:recommended"],
  "timezone": "Europe/Amsterdam",
  "prHourlyLimit": 2,
  "prConcurrentLimit": 5,
  "labels": ["dependencies"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Docker images in Jinja2 template",
      "managerFilePatterns": ["/vps/docker/nextcloud\\.yml\\.j2$/"],
      "matchStrings": [
        "image:\\s*(?<depName>[^:]+):(?<currentValue>[\\d.]+)(?:-alpine)?\\s"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Caddy release in pyinfra caddy script",
      "managerFilePatterns": ["/pyinfra/stages/.*\\.py$/"],
      "matchStrings": [
        "CADDY_VERSION\\s*=\\s*[\"'](?<currentValue>v[\\d.]+)[\"']"
      ],
      "depNameTemplate": "caddyserver/caddy",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Terraform required version",
      "managerFilePatterns": ["/terraform/.*\\.tf$/"],
      "matchStrings": [
        "required_version\\s*=\\s*\"(?<currentValue>[\\d.]+)\""
      ],
      "depNameTemplate": "hashicorp/terraform",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Komodo periphery version",
      "managerFilePatterns": ["/pyinfra/stages/.*\\.py$/"],
      "matchStrings": [
        "PERIPHERY_VERSION\\s*=\\s*[\"'](?<currentValue>v[\\d.]+)[\"']"
      ],
      "depNameTemplate": "moghtech/komodo",
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "description": "Group Nextcloud image updates",
      "matchPackageNames": ["nextcloud"],
      "groupName": "nextcloud"
    },
    {
      "description": "Automerge patch updates for stable images",
      "matchUpdateTypes": ["patch"],
      "matchPackageNames": ["/postgres/", "/redis/"],
      "automerge": true
    }
  ]
}
